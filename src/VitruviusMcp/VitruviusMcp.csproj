<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VitruviusMcp</AssemblyName>
    <RootNamespace>VitruviusMcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Servidor MCP do VITRUVIUS.
    NÃO tem dependências externas de propósito: compila apenas com o SDK do
    .NET 8 (que você já tem). Isso evita erros de restauração de pacotes
    NuGet na hora de buildar na sua máquina.
  -->

</Project>
