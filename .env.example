# Variáveis de Ambiente — VITRUVIUS V2
# Copie este arquivo para .env e preencha seus valores

# Revit Configuration
REVIT_VERSION=2026
REVIT_EDITION=Professional
REVIT_ADDINS_PATH=C:\ProgramData\Autodesk\Revit\Addins\2026

# HTTP Bridge
HTTP_HOST=127.0.0.1
HTTP_PORT=48884
HTTP_TIMEOUT_MS=30000

# MCP Server
MCP_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=Information
LOG_FILE=logs/vitruvius.log

# Development
DEBUG_MODE=false
VERBOSE_OUTPUT=false
